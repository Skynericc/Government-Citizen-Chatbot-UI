# Public browser configuration. Vite embeds every VITE_* value in the built
# JavaScript bundle, so never place passwords, tokens, or private keys here.
VITE_AGENT_URL=/api/agent
VITE_ASR_URL=/api/asr
VITE_TTS_URL=/api/tts
VITE_DEMO_MODE=false
VITE_FILE_ATTACHMENTS_ENABLED=false
VITE_TOOL_CALLS_ENABLED=true
