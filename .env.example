# Copy this file to .env.local (git-ignored) and fill in real values for
# your environment. `npm run dev` enables the local demo by default when
# VITE_AGENT_URL is absent. Production builds never enable canned answers
# unless VITE_DEMO_MODE is explicitly set to true.

# Base URL of the `agent` chat service (contrat_api_frontend.pdf §1).
# In the shared docker-compose network this is http://agent:8100 — but that
# only resolves from *inside* the Docker network. For local dev in a
# browser, use whatever host/port the agent is actually reachable at
# (e.g. via a port mapped to localhost, or a dev reverse-proxy).
VITE_AGENT_URL=http://localhost:8100

# Base URL of the `tts` text-to-speech service (contrat_api_frontend.pdf §3),
# used by the "Listen" button. Leave empty/unset to keep the old no-op
# toggle instead.
VITE_TTS_URL=http://localhost:9991

# Base URL of the `asr` transcription service, used for voice input.
# In local demo mode it may be left empty to simulate a voice turn.
VITE_ASR_URL=http://localhost:8005

# Optional local override. Keep this false in deployed environments.
VITE_DEMO_MODE=false

# Keep hidden until the backend has a supported upload/ingestion endpoint.
# Setting this to true restores the existing frontend attachment controls.
VITE_FILE_ATTACHMENTS_ENABLED=false

# Show Agent/MCP tool calls with each answer. Set false to hide the panel and
# its citizen/detailed display setting without deleting the implementation.
VITE_TOOL_CALLS_ENABLED=true
