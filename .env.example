# Copy this file to .env.local (git-ignored) and fill in real values for
# your environment. Leave VITE_AGENT_URL empty/unset to keep using the
# built-in local demo (canned answers, simulated tool steps) — that's the
# default with no .env file at all, so the app always runs standalone.

# Base URL of the `agent` chat service.
# In the shared docker-compose network this is http://agent:8100 — but that
# only resolves from *inside* the Docker network. For local dev in a
# browser, use whatever host/port the agent is actually reachable at
# (e.g. via a port mapped to localhost, or a dev reverse-proxy).
VITE_AGENT_URL=http://localhost:8100

# Not yet used by the frontend yet (ASR/TTS integration is a later step) —
# listed here for reference against the contract.
# VITE_ASR_URL=http://localhost:8005
# VITE_TTS_URL=http://localhost:9991
